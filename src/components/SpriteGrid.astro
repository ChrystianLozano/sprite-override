      docTitle: 'FORTNITE // SPRITES TEMPLATE | Sprite Tracker',
      metaDesc: 'Interactive Fortnite Sprites Template & Tracker with multilingual support, Mastered state, and HD PNG export.',
      heroTitle: 'OVERRIDE',
      navSeason: 'CHAPTER 7 • SEASON 4',
      heroSubtitle: 'CHAPTER 7 | SEASON 4',
      slogan: 'BREAK THE RULES • CHANGE THE GAME',
      progressTitle: 'COLLECTION PROGRESS',
      obtainedLabel: 'OBTAINED:',
      maxedLabel: 'MASTERED:',
      missingLabel: 'MISSING:',
      downloadBtn: 'DOWNLOAD TEMPLATE',
      tabAll: 'ALL',
      tabMarked: '✓ OBTAINED',
      tabMaxed: '👑 MASTERED',
      tabUnmarked: '🔥 MISSING',
      btnSelectAll: 'MARK OBTAINED',
      btnSelectMaxed: 'MARK MASTERED',
      btnDeselectAll: 'DESELECT ALL',
      searchPlaceholder: 'SEARCH SPRITE...',
      templateTitle: 'SPRITES TEMPLATE',
      epicPartnerText: 'Support me using code <strong style="color: var(--neon-magenta);">MUDO</strong> in the Fortnite item shop <span class="epic-tag">#EpicPartner</span>',
      cardHoverTip: '💡 Click: MISSING ➔ OBTAINED ➔ MASTERED',
      missingBadge: 'MISSING SPRITE!',
      obtainedBadge: 'OBTAINED',
      maxedBadge: 'MASTERED',
      legendMissing: 'MISSING (HIGHLIGHTED)',
      legendObtained: 'OBTAINED (MARKED)',
      legendMaxed: 'MASTERED (MAX LEVEL)',
      modalTitle: 'GENERATING PNG TEMPLATE...',
      modalDesc: 'USE CODE <span style="color: var(--neon-magenta); text-shadow: 0 0 12px var(--neon-magenta);">MUDO</span> IN THE ITEM SHOP 🛍️⚡',
      installApp: 'INSTALL APP',
      toastTitle: '📱 KEEP YOUR COLLECTION SAFE',
      toastBody: 'Install this app to your home screen for 1-tap access and keep your sprites collection safe.',
      toastBtn: 'INSTALL APP 📲',
      toastLater: 'LATER'
    }
  };

  // 3-State Storage: 'unmarked' | 'marked' | 'maxed'
  type SpriteState = 'unmarked' | 'marked' | 'maxed';
  const STORAGE_KEY_V2 = 'fortnite_sprites_state_v2';
  let spriteStates = new Map<string, SpriteState>();

  // Load saved state (with backwards compatibility for v1)
  try {
    const saved = localStorage.getItem(STORAGE_KEY_V2);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (typeof parsed === 'object' && parsed !== null) {
        Object.entries(parsed).forEach(([id, st]) => {
          if (st === 'marked' || st === 'maxed') {
            spriteStates.set(id, st as SpriteState);
          }
        });
      }
    } else {
      // Check legacy v1 state
      const legacy = localStorage.getItem('fortnite_marked_sprites_override_v1');
      if (legacy) {
        const parsed = JSON.parse(legacy);
        if (Array.isArray(parsed)) {
          parsed.forEach((id: string) => spriteStates.set(id, 'marked'));
        }
      }
    }
  } catch (e) {
    console.error('Error loading saved state', e);
  }

  // Detect Language
  let currentLang = (() => {
    try {
      const saved = localStorage.getItem('fortnite_sprites_lang');
      if (saved === 'es' || saved === 'en') return saved;
    } catch (e) {}
    const userLang = navigator.language || (navigator.languages && navigator.languages[0]) || 'es';
    return userLang.toLowerCase().startsWith('es') ? 'es' : 'en';
  })();

  // DOM Elements
  const cards = document.querySelectorAll<HTMLElement>('.sprite-card');
  const progressBar = document.getElementById('progress-bar');
  const progressPercent = document.getElementById('progress-percent');
  const markedCountEl = document.getElementById('marked-count');
  const maxedCountEl = document.getElementById('maxed-count');
  const unmarkedCountEl = document.getElementById('unmarked-count');
  const filterMarkedCountEl = document.getElementById('filter-marked-count');
  const filterMaxedCountEl = document.getElementById('filter-maxed-count');
  const filterUnmarkedCountEl = document.getElementById('filter-unmarked-count');
  const filterBtns = document.querySelectorAll<HTMLButtonElement>('.cyber-tab');
  const searchInput = document.getElementById('search-input') as HTMLInputElement;

  const btnSelectAll = document.getElementById('btn-select-all');
  const btnSelectMaxed = document.getElementById('btn-select-maxed');
  const btnDeselectAll = document.getElementById('btn-deselect-all');
  const btnDownloadPng = document.getElementById('btn-download-png');

  const modalExport = document.getElementById('modal-export');
  const modalTitle = document.getElementById('modal-title');
  const modalDesc = document.getElementById('modal-desc');

  let currentFilter = 'all';
  let currentSearch = '';

  // Apply Language to DOM
  function applyLanguage(lang: string) {
    currentLang = lang;
    try {
      localStorage.setItem('fortnite_sprites_lang', lang);
    } catch (e) {}

    document.documentElement.lang = lang;
    const t = i18nDict[lang] || i18nDict['es'];

    if (t.docTitle) {
      document.title = t.docTitle;
    }

    // Dynamic SEO & Open Graph Meta Tags update based on active language
    const metaDescEl = document.querySelector('meta[name="description"]');
    if (metaDescEl && t.metaDesc) metaDescEl.setAttribute('content', t.metaDesc);

    const ogTitleEl = document.querySelector('meta[property="og:title"]');
    if (ogTitleEl && t.docTitle) ogTitleEl.setAttribute('content', t.docTitle);

    const ogDescEl = document.querySelector('meta[property="og:description"]');
    if (ogDescEl && t.metaDesc) ogDescEl.setAttribute('content', t.metaDesc);

    const ogLocaleEl = document.querySelector('meta[property="og:locale"]');
    if (ogLocaleEl) ogLocaleEl.setAttribute('content', lang === 'es' ? 'es_ES' : 'en_US');

    const twTitleEl = document.querySelector('meta[name="twitter:title"]');
    if (twTitleEl && t.docTitle) twTitleEl.setAttribute('content', t.docTitle);

    const twDescEl = document.querySelector('meta[name="twitter:description"]');
    if (twDescEl && t.metaDesc) twDescEl.setAttribute('content', t.metaDesc);

    // Update JSON-LD Structured Data script
    const jsonLdEl = document.querySelector('script[type="application/ld+json"]');
    if (jsonLdEl && t.docTitle && t.metaDesc) {
      jsonLdEl.textContent = JSON.stringify({
        "@context": "https://schema.org",
        "@type": "WebApplication",
        "name": t.docTitle,
        "url": "https://fortnite.mudo.games",
        "description": t.metaDesc,
        "applicationCategory": "GameApplication",
        "operatingSystem": "All",
        "author": {
          "@type": "Person",
          "name": "Chrystian Fabian Lozano Ramirez",
          "url": "https://chrystian.dev/"
        },
        "publisher": {
          "@type": "Organization",
          "name": "fortnite.mudo.games",
          "url": "https://fortnite.mudo.games/"
        },
        "image": "https://fortnite.mudo.games/og-image.png"
      });
    }

    // Active state of switcher buttons
    const btnEs = document.getElementById('lang-btn-es');
    const btnEn = document.getElementById('lang-btn-en');
    if (btnEs) btnEs.classList.toggle('active', lang === 'es');
    if (btnEn) btnEn.classList.toggle('active', lang === 'en');

    // Hero title: GLITCH for Spanish, OVERRIDE for English
    const glitchTitle = document.querySelector('.glitch-title');
    if (glitchTitle) {
      glitchTitle.textContent = t.heroTitle;
      glitchTitle.setAttribute('data-text', t.heroTitle);
    }

    const navSeason = document.getElementById('nav-season-text');
    if (navSeason) navSeason.textContent = t.navSeason;

    const heroSub = document.getElementById('hero-subtitle-text');
    if (heroSub) heroSub.textContent = t.heroSubtitle;

    const heroSlogan = document.getElementById('hero-slogan-pill');
    if (heroSlogan) heroSlogan.textContent = t.slogan;

    const progTitle = document.getElementById('i18n-progress-title');
    if (progTitle) progTitle.textContent = t.progressTitle;

    const obtLabel = document.getElementById('i18n-obtained-label');
    if (obtLabel) obtLabel.textContent = t.obtainedLabel;

    const maxLabel = document.getElementById('i18n-maxed-label');
    if (maxLabel) maxLabel.textContent = t.maxedLabel;

    const missLabel = document.getElementById('i18n-missing-label');
    if (missLabel) missLabel.textContent = t.missingLabel;

    const dlBtn = document.getElementById('i18n-download-btn');
    if (dlBtn) dlBtn.textContent = t.downloadBtn;

    const tabAll = document.getElementById('i18n-tab-all');
    if (tabAll) tabAll.textContent = t.tabAll;

    const tabMarked = document.getElementById('i18n-tab-marked');
    if (tabMarked) tabMarked.textContent = t.tabMarked;

    const tabMaxed = document.getElementById('i18n-tab-maxed');
    if (tabMaxed) tabMaxed.textContent = t.tabMaxed;

    const tabUnmarked = document.getElementById('i18n-tab-unmarked');
    if (tabUnmarked) tabUnmarked.textContent = t.tabUnmarked;

    const btnSelAll = document.getElementById('btn-select-all');
    if (btnSelAll) btnSelAll.textContent = t.btnSelectAll;

    const btnSelMax = document.getElementById('btn-select-maxed');
    if (btnSelMax) btnSelMax.textContent = t.btnSelectMaxed;

    const btnDeselAll = document.getElementById('btn-deselect-all');
    if (btnDeselAll) btnDeselAll.textContent = t.btnDeselectAll;

    if (searchInput) searchInput.placeholder = t.searchPlaceholder;

    const tmplTitle = document.getElementById('i18n-template-title');
    if (tmplTitle) tmplTitle.textContent = t.templateTitle;

    const epicPartnerEl = document.getElementById('i18n-epic-partner-text');
    if (epicPartnerEl) epicPartnerEl.innerHTML = t.epicPartnerText;

    const legMiss = document.getElementById('i18n-legend-missing');
    if (legMiss) legMiss.textContent = t.legendMissing;

    const legObt = document.getElementById('i18n-legend-obtained');
    if (legObt) legObt.textContent = t.legendObtained;

    const legMax = document.getElementById('i18n-legend-maxed');
    if (legMax) legMax.textContent = t.legendMaxed;

    const installAppEl = document.getElementById('i18n-install-app');
    if (installAppEl) installAppEl.textContent = t.installApp;

    const toastTitleEl = document.getElementById('i18n-toast-title');
    if (toastTitleEl) toastTitleEl.textContent = t.toastTitle;

    const toastBodyEl = document.getElementById('i18n-toast-body');
    if (toastBodyEl) toastBodyEl.textContent = t.toastBody;

    const toastBtnEl = document.getElementById('i18n-toast-btn');
    if (toastBtnEl) toastBtnEl.textContent = t.toastBtn;

    const toastLaterEl = document.getElementById('i18n-toast-later');
    if (toastLaterEl) toastLaterEl.textContent = t.toastLater;

    // Update card titles, tooltips and attributes
    cards.forEach((card) => {
      const cardTitleEl = card.querySelector('.sprite-title');
      const text = card.getAttribute(`data-title-${lang}`) || card.getAttribute('data-title-es') || '';
      if (cardTitleEl) cardTitleEl.textContent = text;
      card.dataset.title = text.toLowerCase();

      const hoverTipEl = card.querySelector('.hover-tip-text');
      if (hoverTipEl) hoverTipEl.textContent = t.cardHoverTip;
    });

    updateUI();
  }

  // Update UI Cards and Statistics
  function updateUI() {
    const total = cards.length;
    let markedCount = 0;
    let maxedCount = 0;
    const t = i18nDict[currentLang] || i18nDict['es'];

    cards.forEach((card) => {
      const id = card.dataset.id || '';
      const state = spriteStates.get(id) || 'unmarked';

      const badgeText = card.querySelector('.status-text');
      const badgeIcon = card.querySelector('.status-icon');
      const checkIcon = card.querySelector<HTMLElement>('.check-icon');
      const starIcon = card.querySelector<HTMLElement>('.star-icon');

      card.classList.remove('unmarked', 'marked', 'maxed');

      if (state === 'marked') {
        markedCount++;
        card.classList.add('marked');

        if (badgeText) badgeText.textContent = t.obtainedBadge;
        if (badgeIcon) badgeIcon.textContent = '✓';
        if (checkIcon) checkIcon.style.display = 'block';
        if (starIcon) starIcon.style.display = 'none';
      } else if (state === 'maxed') {
        maxedCount++;
        card.classList.add('maxed');

        if (badgeText) badgeText.textContent = t.maxedBadge;
        if (badgeIcon) badgeIcon.textContent = '👑';
        if (checkIcon) checkIcon.style.display = 'none';
        if (starIcon) starIcon.style.display = 'inline-block';
      } else {
        card.classList.add('unmarked');

        if (badgeText) badgeText.textContent = t.missingBadge;
        if (badgeIcon) badgeIcon.textContent = '🔥';
        if (checkIcon) checkIcon.style.display = 'none';
        if (starIcon) starIcon.style.display = 'none';
      }

      // Filter Visibility: "OBTENIDOS" includes both marked and maxed spirits
      const titleMatches = (card.dataset.title || '').includes(currentSearch.toLowerCase());
      let filterMatches = true;

      if (currentFilter === 'marked') filterMatches = (state === 'marked' || state === 'maxed');
      if (currentFilter === 'maxed') filterMatches = (state === 'maxed');
      if (currentFilter === 'unmarked') filterMatches = (state === 'unmarked');

      if (titleMatches && filterMatches) {
        card.style.display = 'flex';
      } else {
        card.style.display = 'none';
      }
    });

    const unmarkedCount = total - (markedCount + maxedCount);
    const percent = total > 0 ? Math.round(((markedCount + maxedCount) / total) * 100) : 0;

    if (progressBar) progressBar.style.width = `${percent}%`;
    if (progressPercent) progressPercent.textContent = `${percent}%`;
    if (markedCountEl) markedCountEl.textContent = markedCount.toString();
    if (maxedCountEl) maxedCountEl.textContent = maxedCount.toString();
    if (unmarkedCountEl) unmarkedCountEl.textContent = unmarkedCount.toString();

    if (filterMarkedCountEl) filterMarkedCountEl.textContent = (markedCount + maxedCount).toString();
    if (filterMaxedCountEl) filterMaxedCountEl.textContent = maxedCount.toString();
    if (filterUnmarkedCountEl) filterUnmarkedCountEl.textContent = unmarkedCount.toString();

    // Save to LocalStorage
    try {
      const stateObj: Record<string, string> = {};
      spriteStates.forEach((val, key) => {
        stateObj[key] = val;
      });
      localStorage.setItem(STORAGE_KEY_V2, JSON.stringify(stateObj));
    } catch (e) {
      console.error('Error saving state', e);
    }
  }

  // Web Audio API Synthesizer for Zero-Latency Retro Sound Effects
  let audioCtx: AudioContext | null = null;

  function getAudioContext(): AudioContext {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      audioCtx = new AudioContextClass();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // 1. Smooth Pleasant Chime for OBTENIDO
  function playObtainedSound() {
    try {
      const ctx = getAudioContext();
      const now = ctx.currentTime;

      const osc = ctx.createOscillator();
      const gain = ctx.createGain();

      osc.type = 'sine';
      osc.frequency.setValueAtTime(659.25, now); // E5
      osc.frequency.setValueAtTime(987.77, now + 0.07); // B5

      gain.gain.setValueAtTime(0.12, now);
      gain.gain.exponentialRampToValueAtTime(0.001, now + 0.28);

      osc.connect(gain);
      gain.connect(ctx.destination);

      osc.start(now);
      osc.stop(now + 0.28);
    } catch (e) {}
  }

  // 2. Iconic 8-Bit Mario 1-UP Extra Life Sound for MAXIADO / MASTERED
  function playMaxed1UpSound() {
    try {
      const ctx = getAudioContext();
      const now = ctx.currentTime;

      // Authentic 6-note 1UP sequence: E6, G6, E7, C7, D7, G7
      const notes = [
        { freq: 1318.51, duration: 0.07 }, // E6
        { freq: 1567.98, duration: 0.07 }, // G6
        { freq: 2637.02, duration: 0.07 }, // E7
        { freq: 2093.00, duration: 0.07 }, // C7
        { freq: 2349.32, duration: 0.07 }, // D7
        { freq: 3135.96, duration: 0.16 }  // G7
      ];

      let noteTime = now;
      notes.forEach((note) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'square'; // Authentic NES 8-bit retro pulse
        osc.frequency.setValueAtTime(note.freq, noteTime);

        gain.gain.setValueAtTime(0.10, noteTime);
        gain.gain.exponentialRampToValueAtTime(0.001, noteTime + note.duration);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(noteTime);
        osc.stop(noteTime + note.duration);

        noteTime += note.duration;
      });
    } catch (e) {}
  }

  // 3. Short Retro Game Over / Game Lost Sound for returning to FALTANTE
  function playGameOverSound() {
    try {
      const ctx = getAudioContext();
      const now = ctx.currentTime;

      // Quick 3-note descending game over drop: G4 -> D#4 -> C4 with pitch slide down
      const notes = [
        { freq: 392.00, duration: 0.08 }, // G4
        { freq: 311.13, duration: 0.08 }, // D#4 / Eb4
        { freq: 261.63, duration: 0.14 }  // C4
      ];

      let noteTime = now;
      notes.forEach((note, idx) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();

        osc.type = 'sawtooth'; // Retro arcade buzz
        osc.frequency.setValueAtTime(note.freq, noteTime);
        
        if (idx === notes.length - 1) {
          osc.frequency.exponentialRampToValueAtTime(180, noteTime + note.duration);
        }

        gain.gain.setValueAtTime(0.10, noteTime);
        gain.gain.exponentialRampToValueAtTime(0.001, noteTime + note.duration);

        osc.connect(gain);
        gain.connect(ctx.destination);

        osc.start(noteTime);
        osc.stop(noteTime + note.duration);

        noteTime += note.duration;
      });
    } catch (e) {}
  }

  // Helper to spawn electric golden sparks burst on MAXIADO state
  function triggerGoldenSparks(card: HTMLElement) {
    const particleCount = 18;
    for (let i = 0; i < particleCount; i++) {
      const spark = document.createElement('span');
      spark.className = 'spark-particle';

      const size = Math.random() * 8 + 4; // 4px to 12px
      spark.style.width = `${size}px`;
      spark.style.height = `${size}px`;

      spark.style.left = `calc(50% - ${size / 2}px)`;
      spark.style.top = `calc(50% - ${size / 2}px)`;

      const angle = Math.random() * Math.PI * 2;
      const distance = Math.random() * 110 + 35; // 35px to 145px
      const tx = Math.cos(angle) * distance;
      const ty = Math.sin(angle) * distance;
      const rot = (Math.random() - 0.5) * 360;

      spark.style.setProperty('--tx', `${tx}px`);
      spark.style.setProperty('--ty', `${ty}px`);
      spark.style.setProperty('--rot', `${rot}deg`);

      card.appendChild(spark);

      setTimeout(() => {
        spark.remove();
      }, 600);
    }
  }

  // Card click handler: cycles Unmarked -> Marked -> Maxed -> Unmarked + trigger Glitch, Audio & Sparks
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      // Trigger instant Cyberpunk glitch visual effect
      card.classList.remove('is-glitching');
      void card.offsetWidth; // Force CSS reflow to restart animation
      card.classList.add('is-glitching');
      setTimeout(() => {
        card.classList.remove('is-glitching');
      }, 400);

      const id = card.dataset.id || '';
      const currentState = spriteStates.get(id) || 'unmarked';

      if (currentState === 'unmarked') {
        spriteStates.set(id, 'marked');
        playObtainedSound();
      } else if (currentState === 'marked') {
        spriteStates.set(id, 'maxed');
        triggerGoldenSparks(card as HTMLElement);
        playMaxed1UpSound();
      } else {
        spriteStates.delete(id);
        playGameOverSound();
      }
      updateUI();
    });
  });

  // Filter Buttons
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter || 'all';
      updateUI();
    });
  });

  // Search Input Handler
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      updateUI();
    });
  }

  // Quick Selection Helpers
  if (btnSelectAll) {
    btnSelectAll.addEventListener('click', () => {
      cards.forEach((card) => {
        const id = card.dataset.id;
        if (id) spriteStates.set(id, 'marked');
      });
      updateUI();
    });
  }

  if (btnSelectMaxed) {
    btnSelectMaxed.addEventListener('click', () => {
      cards.forEach((card) => {
        const id = card.dataset.id;
        if (id) spriteStates.set(id, 'maxed');
      });
      updateUI();
    });
  }

  if (btnDeselectAll) {
    btnDeselectAll.addEventListener('click', () => {
      spriteStates.clear();
      updateUI();
    });
  }

  // Download PNG Template
  if (btnDownloadPng) {
    btnDownloadPng.addEventListener('click', async () => {
      const captureArea = document.getElementById('template-capture-area');
      if (!captureArea) return;

      const t = i18nDict[currentLang] || i18nDict['es'];

      if (modalExport && modalTitle && modalDesc) {
        modalTitle.textContent = t.modalTitle;
        modalDesc.innerHTML = t.modalDesc;
        modalExport.classList.add('active');
      }

      try {
        await new Promise((resolve) => setTimeout(resolve, 200));

        const canvas = await html2canvas(captureArea, {
          backgroundColor: '#060913',
          scale: 2,
          logging: false,
          useCORS: true,
          allowTaint: true,
          windowWidth: 1280,
          onclone: (clonedDoc) => {
            const clonedArea = clonedDoc.getElementById('template-capture-area');
            if (clonedArea) {
              clonedArea.style.width = '1200px';
              clonedArea.style.maxWidth = '1200px';
              clonedArea.style.margin = '0 auto';
              clonedArea.style.padding = '2rem';
              clonedArea.style.boxSizing = 'border-box';

              const clonedHeader = clonedArea.querySelector<HTMLElement>('.template-watermark-header');
              if (clonedHeader) {
                clonedHeader.style.flexDirection = 'row';
                clonedHeader.style.justifyContent = 'space-between';
                clonedHeader.style.alignItems = 'center';
              }

              const clonedGrid = clonedArea.querySelector<HTMLElement>('.sprite-grid');
              if (clonedGrid) {
                clonedGrid.style.display = 'grid';
                clonedGrid.style.gridTemplateColumns = 'repeat(auto-fill, minmax(220px, 1fr))';
                clonedGrid.style.gap = '1.75rem';
              }

              clonedArea.querySelectorAll('.card-hover-tip').forEach((el) => {
                (el as HTMLElement).style.display = 'none';
              });
            }

            const clonedImgs = clonedDoc.querySelectorAll<HTMLImageElement>('.sprite-img');
            clonedImgs.forEach((img) => {
              img.style.objectFit = 'contain';
              img.style.width = 'auto';
              img.style.height = 'auto';
              img.style.maxWidth = '100%';
              img.style.maxHeight = '100%';
            });
          }
        });

        const mainTitleWord = currentLang === 'es' ? 'glitch' : 'override';
        const filterSuffix = currentFilter === 'marked' ? 'obtenidos' : currentFilter === 'maxed' ? 'maxiados' : currentFilter === 'unmarked' ? 'faltantes' : 'todos';

        canvas.toBlob((blob) => {
          if (blob) {
            saveAs(blob, `fortnite-${mainTitleWord}-sprites-${filterSuffix}-${Date.now()}.png`);
          }
        }, 'image/png');
      } catch (err) {
        console.error('Error generating PNG export', err);
        alert('Ocurrió un error al generar la imagen PNG.');
      } finally {
        if (modalExport) modalExport.classList.remove('active');
      }
    });
  }

  // Language Switcher Events
  document.getElementById('lang-btn-es')?.addEventListener('click', () => applyLanguage('es'));
  document.getElementById('lang-btn-en')?.addEventListener('click', () => applyLanguage('en'));

  // Initial Language Setup
  applyLanguage(currentLang);

  // Service Worker Registration for PWA support
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch((err) => {
        console.log('ServiceWorker registration error:', err);
      });
    });
  }

  // PWA Install Prompt Handler
  let deferredPrompt: any = null;
  const pwaInstallBtn = document.getElementById('pwa-install-btn');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    if (pwaInstallBtn) {
      pwaInstallBtn.style.display = 'inline-flex';
    }
  });

  if (pwaInstallBtn) {
    pwaInstallBtn.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          pwaInstallBtn.style.display = 'none';
        }
        deferredPrompt = null;
      }
    });
  }

  window.addEventListener('appinstalled', () => {
    if (pwaInstallBtn) pwaInstallBtn.style.display = 'none';
    const toastBanner = document.getElementById('install-toast-banner');
    if (toastBanner) toastBanner.classList.remove('active');
    deferredPrompt = null;
  });

  // Non-Intrusive PWA Toast Notification Trigger
  const TOAST_DISMISSED_KEY = 'fortnite_sprites_install_toast_closed';
  const toastBanner = document.getElementById('install-toast-banner');
  const toastCloseBtn = document.getElementById('toast-close-btn');
  const toastInstallBtn = document.getElementById('toast-install-action');
  const toastDismissBtn = document.getElementById('toast-dismiss-action');

  function dismissToast() {
    if (toastBanner) toastBanner.classList.remove('active');
    try {
      localStorage.setItem(TOAST_DISMISSED_KEY, 'true');
    } catch (e) {}
  }

  if (toastCloseBtn) toastCloseBtn.addEventListener('click', dismissToast);
  if (toastDismissBtn) toastDismissBtn.addEventListener('click', dismissToast);

  if (toastInstallBtn) {
    toastInstallBtn.addEventListener('click', async () => {
      dismissToast();
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          if (pwaInstallBtn) pwaInstallBtn.style.display = 'none';
        }
        deferredPrompt = null;
      } else {
        // Fallback info for iOS / browsers without beforeinstallprompt
        alert(currentLang === 'es' 
          ? 'Para instalar en tu móvil:\n• En Safari (iPhone): Toca Compartir (⎋) ➔ "Agregar a inicio"\n• En Android: Toca Opciones (⋮) ➔ "Instalar aplicación"'
          : 'To install on your device:\n• On Safari (iPhone): Tap Share (⎋) ➔ "Add to Home Screen"\n• On Android: Tap Menu (⋮) ➔ "Install app"'
        );
      }
    });
  }

  // Trigger toast after 18 seconds of interaction if not previously dismissed
  const isDismissed = localStorage.getItem(TOAST_DISMISSED_KEY) === 'true';
  if (!isDismissed) {
    setTimeout(() => {
      if (toastBanner && !localStorage.getItem(TOAST_DISMISSED_KEY)) {
        toastBanner.classList.add('active');
      }
    }, 18000);
  }

  // Handle Lazy Load + Glitch Reveal Effect for Sprite Images
  const spriteImgs = document.querySelectorAll<HTMLImageElement>('.sprite-img');
  spriteImgs.forEach((img) => {
    const wrapper = img.closest('.sprite-image-wrapper');
    if (wrapper) wrapper.classList.add('is-loading');

    function onImageLoaded() {
      if (wrapper) wrapper.classList.remove('is-loading');
      img.classList.add('is-loaded');
    }

    if (img.complete && img.naturalWidth > 0) {
      onImageLoaded();
    } else {
      img.addEventListener('load', onImageLoaded);
      img.addEventListener('error', () => {
        if (wrapper) wrapper.classList.remove('is-loading');
        img.classList.add('is-loaded');
      });
    }
  });
</script>

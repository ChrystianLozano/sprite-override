  // 3-State Storage: 'unmarked' | 'marked' | 'maxed'
  type SpriteState = 'unmarked' | 'marked' | 'maxed';
  const STORAGE_KEY_V2 = 'fortnite_sprites_state_v2';
  let spriteStates = new Map<string, SpriteState>();

  // Load saved state (with backwards compatibility for v1)
  try {
    const saved = localStorage.getItem(STORAGE_KEY_V2);
    if (saved) {
      const parsed = JSON.parse(saved);
      if (typeof parsed === 'object' && parsed !== null) {
        Object.entries(parsed).forEach(([id, st]) => {
          if (st === 'marked' || st === 'maxed') {
            spriteStates.set(id, st as SpriteState);
          }
        });
      }
    } else {
      // Check legacy v1 state
      const legacy = localStorage.getItem('fortnite_marked_sprites_override_v1');
      if (legacy) {
        const parsed = JSON.parse(legacy);
        if (Array.isArray(parsed)) {
          parsed.forEach((id: string) => spriteStates.set(id, 'marked'));
        }
      }
    }
  } catch (e) {
    console.error('Error loading saved state', e);
  }

  // Detect Language
  let currentLang = (() => {
    try {
      const saved = localStorage.getItem('fortnite_sprites_lang');
      if (saved === 'es' || saved === 'en') return saved;
    } catch (e) {}
    const userLang = navigator.language || (navigator.languages && navigator.languages[0]) || 'es';
    return userLang.toLowerCase().startsWith('es') ? 'es' : 'en';

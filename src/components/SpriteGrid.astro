  'espiritu-sonic-hacker-sonic-cheatmaster-sprite-fortnite.webp': { es: 'Espíritu Sonic Hacker', en: 'Sonic Cheatmaster Sprite' },
};

function parseSpriteTitles(filename: string): { titleEs: string; titleEn: string } {
  if (spriteTranslations[filename]) {
    return { titleEs: spriteTranslations[filename].es, titleEn: spriteTranslations[filename].en };
  }

  const clean = filename.replace(/\.[^/.]+$/, '').replace(/-fortnite$/i, '');
  const words = clean.replace(/-/g, ' ').split(' ');
  const formatted = words.map(w => w.charAt(0).toUpperCase() + w.slice(1)).join(' ');
  return { titleEs: formatted, titleEn: formatted };
}

const sprites = Object.entries(imageModules).map(([path, mod]) => {
  const filename = path.split('/').pop() || '';
  const { titleEs, titleEn } = parseSpriteTitles(filename);

  return {
    id: filename,
    filename,
    titleEs,
    titleEn,
    imageSrc: mod.default.src,
    imageMetadata: mod.default,
  };
});
---

<!-- Floating Sticky Control HUD -->
<div class="sticky-controls-wrapper">

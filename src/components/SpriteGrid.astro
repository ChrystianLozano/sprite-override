  'shadow',
  'sobreescudo',
  'sonic',
  'tails',
  'vampiro'
];

function getFamily(filename: string): string {
  if (filename.includes('victorioso') || filename.includes('corona') || filename.includes('Crown')) return 'corona';
  if (filename.includes('crash') || filename.includes('BodySlam')) return 'crash-bandicoot';
  if (filename.includes('cumple') || filename.includes('Birthday')) return 'cumpleanero';
  if (filename.includes('vampir') || filename.includes('HealthSiphon')) return 'vampiro';
  if (filename.includes('ciervo') || filename.includes('IncreasedMelee') || filename.includes('deer')) return 'ciervo';
  if (filename.includes('espeluznante') || filename.includes('PhaseDash') || filename.includes('spooky')) return 'espeluznante';
  if (filename.includes('mapache') || filename.includes('WinnerD') || filename.includes('dumpster')) return 'mapache';
  if (filename.includes('miel') || filename.includes('honey') || filename.includes('WinnerE')) return 'miel';
  if (filename.includes('sauce') || filename.includes('willow') || filename.includes('CargoLying')) return 'sauce-de-un-deseo';
  if (filename.includes('8-bit') || filename.includes('8-bits') || filename.includes('8Bit')) return '8-bits';
  if (filename.includes('arbustin') || filename.includes('Bush')) return 'arbustin';
  if (filename.includes('aventurero') || filename.includes('Dwarf')) return 'aventurero';
  if (filename.includes('blinky') || filename.includes('GhostDamage')) return 'blinky';
  if (filename.includes('estanque') || filename.includes('WinnerA')) return 'estanque';
  if (filename.includes('tormenta') || filename.includes('StormScout')) return 'explorador-tormenta';
  if (filename.includes('jackrabbit') || filename.includes('DoubleJump')) return 'jackrabbit';
  if (filename.includes('jonesy') || filename.includes('Jonesy')) return 'jonesy';
  if (filename.includes('killswitch') || filename.includes('Killswitch')) return 'killswitch';
  if (filename.includes('klombo') || filename.includes('Klombo')) return 'klombo';
  if (filename.includes('morgana') || filename.includes('IncreaseHeals')) return 'morgana';
  if (filename.includes('onigiri') || filename.includes('WinnerC')) return 'onigiri';
  if (filename.includes('rayos-x') || filename.includes('WinnerB')) return 'rayos-x';
  if (filename.includes('shadow') || filename.includes('ReloadOverTime')) return 'shadow';
  if (filename.includes('sobreescudo') || filename.includes('Overshield')) return 'sobreescudo';
  if (filename.includes('tails') || filename.includes('NarrowFleaMonkey')) return 'tails';
  if (filename.includes('sonic') || filename.includes('NarrowFlea')) return 'sonic';
  for (const f of familyOrder) {
    if (filename.includes(f)) return f;
  }
  return filename;
}

function getTier(filename: string): number {
  if (filename.includes('quack') || filename.includes('Quack') || filename.includes('cuac') || filename.includes('Cuac')) return 7;
  if (filename.includes('dulce-o-truco') || filename.includes('trick-or-treat') || filename.includes('TrickTreat')) return 6;
  if (filename.includes('cazarreompensas') || filename.includes('cazarrecompensas') || filename.includes('bounty-hunter') || filename.includes('BountyHunter') || filename.includes('azarrecompensas')) return 5;
  if (filename.includes('botin') || filename.includes('loot-hacker') || (filename.includes('Hacker') && !filename.includes('Cheatmaster'))) return 4;
  if (filename.includes('hacker') || filename.includes('cheatmaster') || filename.includes('Cheatmaster')) return 3;
  if (filename.includes('dorado') || filename.includes('dorada') || filename.includes('gold') || filename.includes('Gold')) return 2;
  return 1;
}

function getBountyReward(filename: string, tier: number): string {
  let hash = 0;
  for (let i = 0; i < filename.length; i++) {
    hash = ((hash << 5) - hash + filename.charCodeAt(i)) | 0;
  }
  const absHash = Math.abs(hash);

  if (tier === 7) return '1,000,000,000-';
  if (tier === 2) {
    // Dorado / Gold
    const millions = 500 + (absHash % 490);
    return `${millions},000,000-`;
  }
  if (tier === 5) {
    // Cazarrecompensas / Bounty Hunter
    const millions = 300 + (absHash % 450);
    return `${millions},500,000-`;
  }
  if (tier === 4 || tier === 3) {
    // Hacker / Loot Hacker
    const millions = 110 + (absHash % 240);
    const thousands = String(100 + (absHash % 899)).padStart(3, '0');
    return `${millions},${thousands},000-`;
  }
  if (tier === 6) {
    // Dulce o Truco
    const millions = 65 + (absHash % 95);
    return `${millions},000,000-`;
  }
  // Base sprites (like reference 10,032,023- / 15,000,000-)
  const millions = 10 + (absHash % 45);
  const mid = String(absHash % 999).padStart(3, '0');
  const low = String((absHash >> 3) % 999).padStart(3, '0');
  return `${millions},${mid},${low}-`;
}

const sprites = Object.entries(imageModules).map(([path, mod]) => {
  const filename = path.split('/').pop() || '';
  const { titleEs, titleEn } = parseSpriteTitles(filename);
  const tier = getTier(filename);
  const bountyReward = getBountyReward(filename, tier);
  const season = getSpriteSeason(filename, path);

  return {
    id: filename,
    filename,
    titleEs,
    titleEn,
    tier,
    bountyReward,
    season,
    imageSrc: mod.default.src,
    imageMetadata: mod.default,
  };
}).sort((a, b) => {
  const famA = getFamily(a.filename);
  const famB = getFamily(b.filename);
  const idxA = familyOrder.indexOf(famA);
  const idxB = familyOrder.indexOf(famB);
  if (idxA !== idxB) {
    if (idxA === -1) return 1;
    if (idxB === -1) return -1;
    return idxA - idxB;
  }
  const tierA = getTier(a.filename);
  const tierB = getTier(b.filename);
  if (tierA !== tierB) {
    return tierA - tierB;
  }
  return a.filename.localeCompare(b.filename);
});

const c7s4Count = sprites.filter((s) => s.season === 'c7s4').length;
const c7s5Count = sprites.filter((s) => s.season === 'c7s5').length;

    <div class="cyber-stats-bar">
      <div class="cyber-progress-box">
        <div class="cyber-progress-header">
          <span id="i18n-progress-title">PROGRESO DE COLECCIÓN</span>
          <span id="progress-percent" style="color: var(--neon-cyan);">0%</span>
        </div>
        <div class="cyber-bar-bg">

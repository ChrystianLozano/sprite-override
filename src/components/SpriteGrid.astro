  // Pre-cache card DOM references once to avoid 600+ querySelector calls per interaction
  interface CardRef {
    card: HTMLElement;
    id: string;
    season: string;
    titleEsRaw: string;
    titleEnRaw: string;
    titleEsLower: string;
    titleEnLower: string;
    cardTitleEl: HTMLElement | null;
    hoverTipEl: HTMLElement | null;
    wantedHeaderEl: HTMLElement | null;
    wantedDeadAliveEl: HTMLElement | null;
    badgeText: HTMLElement | null;
    badgeIcon: HTMLElement | null;
    checkIcon: HTMLElement | null;
    starIcon: HTMLElement | null;
  }

  const cardRefMap = new Map<HTMLElement, CardRef>();
  const cardRefs: CardRef[] = Array.from(cards).map((card) => {
    const id = card.dataset.id || '';
    const season = card.dataset.season || 'c7s4';
    const titleEsRaw = card.getAttribute('data-title-es') || '';
    const titleEnRaw = card.getAttribute('data-title-en') || titleEsRaw;
    const ref: CardRef = {
      card,
      id,
      season,
      titleEsRaw,
      titleEnRaw,
      titleEsLower: titleEsRaw.toLowerCase(),
      titleEnLower: titleEnRaw.toLowerCase(),
      cardTitleEl: card.querySelector<HTMLElement>('.sprite-title'),
      hoverTipEl: card.querySelector<HTMLElement>('.hover-tip-text'),
      wantedHeaderEl: card.querySelector<HTMLElement>('.wanted-header-text'),
      wantedDeadAliveEl: card.querySelector<HTMLElement>('.wanted-dead-alive'),
      badgeText: card.querySelector<HTMLElement>('.status-text'),
      badgeIcon: card.querySelector<HTMLElement>('.status-icon'),
      checkIcon: card.querySelector<HTMLElement>('.check-icon'),
      starIcon: card.querySelector<HTMLElement>('.star-icon')
    };
    cardRefMap.set(card, ref);
    return ref;
  });

  function syncSingleCardDOM(ref: CardRef, t: Record<string, string>, searchNormalized: string) {
    const state = spriteStates.get(ref.id) || 'unmarked';
    const { card, badgeText, badgeIcon, checkIcon, starIcon } = ref;

    card.classList.remove('unmarked', 'marked', 'maxed');

    if (state === 'marked') {
      card.classList.add('marked');
      if (badgeText) badgeText.textContent = t.obtainedBadge;
      if (badgeIcon) badgeIcon.textContent = '✓';
      if (checkIcon) checkIcon.style.display = 'block';
      if (starIcon) starIcon.style.display = 'none';
    } else if (state === 'maxed') {
      card.classList.add('maxed');
      if (badgeText) badgeText.textContent = t.maxedBadge;
      if (badgeIcon) badgeIcon.textContent = '👑';
      if (checkIcon) checkIcon.style.display = 'none';
      if (starIcon) starIcon.style.display = 'inline-block';
    } else {
      card.classList.add('unmarked');
      if (badgeText) badgeText.textContent = t.missingBadge;
      if (badgeIcon) badgeIcon.textContent = '🔥';
      if (checkIcon) checkIcon.style.display = 'none';
      if (starIcon) starIcon.style.display = 'none';
    }

    const seasonMatches = currentSeason === 'all' || ref.season === currentSeason;

    const titleMatches =
      !searchNormalized ||
      ref.titleEsLower.includes(searchNormalized) ||
      ref.titleEnLower.includes(searchNormalized);

    let filterMatches = true;
    if (currentFilter === 'marked') filterMatches = state === 'marked' || state === 'maxed';
    else if (currentFilter === 'maxed') filterMatches = state === 'maxed';
    else if (currentFilter === 'unmarked') filterMatches = state === 'unmarked';

    const shouldShow = seasonMatches && titleMatches && filterMatches;
    const nextDisplay = shouldShow ? 'flex' : 'none';
    if (card.style.display !== nextDisplay) {
      card.style.display = nextDisplay;
    }
  }

  let saveTimer: ReturnType<typeof setTimeout> | null = null;
  function scheduleSaveState() {
    if (saveTimer !== null) clearTimeout(saveTimer);
    saveTimer = setTimeout(() => {
      try {
        const stateObj: Record<string, string> = {};
        spriteStates.forEach((val, key) => {
          stateObj[key] = val;
        });
        localStorage.setItem(STORAGE_KEY_V2, JSON.stringify(stateObj));
      } catch (e) {
        console.error('Error saving state', e);
      }
    }, 120);
  }

  function updateStatsCounters() {
    const seasonCards = cardRefs.filter((ref) => currentSeason === 'all' || ref.season === currentSeason);
    const total = seasonCards.length;
    let markedCount = 0;
    let maxedCount = 0;

    seasonCards.forEach((ref) => {
      const state = spriteStates.get(ref.id) || 'unmarked';
      if (state === 'marked') markedCount++;
      else if (state === 'maxed') maxedCount++;
    });

    const unmarkedCount = total - (markedCount + maxedCount);
    const percent = total > 0 ? Math.round(((markedCount + maxedCount) / total) * 100) : 0;

    if (progressBar) progressBar.style.width = `${percent}%`;
    if (progressPercent) progressPercent.textContent = `${percent}%`;
    if (markedCountEl) markedCountEl.textContent = markedCount.toString();
    if (maxedCountEl) maxedCountEl.textContent = maxedCount.toString();
    if (unmarkedCountEl) unmarkedCountEl.textContent = unmarkedCount.toString();

    if (filterAllCountEl) filterAllCountEl.textContent = total.toString();
    if (filterMarkedCountEl) filterMarkedCountEl.textContent = (markedCount + maxedCount).toString();
    if (filterMaxedCountEl) filterMaxedCountEl.textContent = maxedCount.toString();
    if (filterUnmarkedCountEl) filterUnmarkedCountEl.textContent = unmarkedCount.toString();

    if (emptyStateEl) {
      emptyStateEl.style.display = total === 0 ? 'flex' : 'none';
    }

    scheduleSaveState();
  }

  // Update all UI Cards and Statistics (used on filter/search/bulk actions)
  function updateUI() {
    const t = i18nDict[currentLang] || i18nDict['es'];
    const searchNormalized = currentSearch.trim().toLowerCase();

    cardRefs.forEach((ref) => {
      syncSingleCardDOM(ref, t, searchNormalized);
    });

    updateStatsCounters();
  }

  // Web Audio API Synthesizer for Zero-Latency Retro Sound Effects
  let audioCtx: AudioContext | null = null;

  function getAudioContext(): AudioContext {
    if (!audioCtx) {
      const AudioContextClass = window.AudioContext || (window as any).webkitAudioContext;
      audioCtx = new AudioContextClass();
    }
    if (audioCtx.state === 'suspended') {
      audioCtx.resume();
    }
    return audioCtx;
  }

  // 1. Pirate Cutlass Slash + Gold Doubloon / Belly Coin Clink for OBTENIDO (CAZADO)
  function playObtainedSound() {
    try {
      const ctx = getAudioContext();
      const now = ctx.currentTime;

      // A) Quick metallic sword/cutlass unsheathe swish
      const swishOsc = ctx.createOscillator();
      const swishGain = ctx.createGain();
      swishOsc.type = 'triangle';
      swishOsc.frequency.setValueAtTime(950, now);
      swishOsc.frequency.exponentialRampToValueAtTime(2800, now + 0.055);
      swishGain.gain.setValueAtTime(0.06, now);
      swishGain.gain.exponentialRampToValueAtTime(0.001, now + 0.06);
      swishOsc.connect(swishGain);
      swishGain.connect(ctx.destination);
      swishOsc.start(now);
      swishOsc.stop(now + 0.06);

      // B) Double Gold Doubloon / Belly Coin Clink (Metallic Harmonic Bell Ring)
      const coinHits = [
        { time: now + 0.04, f1: 2093.0, f2: 3135.96, dur: 0.18 }, // First gold coin clink
        { time: now + 0.11, f1: 2637.02, f2: 4186.01, dur: 0.28 } // Second higher gold coin ring
      ];

      coinHits.forEach((coin) => {
        [coin.f1, coin.f2].forEach((freq, idx) => {
          const osc = ctx.createOscillator();
          const gain = ctx.createGain();
          osc.type = 'sine';
          osc.frequency.setValueAtTime(freq, coin.time);
          gain.gain.setValueAtTime(idx === 0 ? 0.11 : 0.06, coin.time);
          gain.gain.exponentialRampToValueAtTime(0.001, coin.time + coin.dur);
          osc.connect(gain);
          gain.connect(ctx.destination);
          osc.start(coin.time);
          osc.stop(coin.time + coin.dur);
        });
      });
    } catch (e) {}
  }

  // 2. One Piece / Grand Line Pirate Treasure Chest Fanfare for MAXIADO (TESORO LEGENDARIO)
  function playMaxed1UpSound() {
    try {
      const ctx = getAudioContext();
      const now = ctx.currentTime;

      // Triumphant Pirate Brass / Accordion Sea-Shanty Fanfare (D5 -> F5 -> G5 -> A5 -> G5 -> A5 -> D6!)
      const fanfareNotes = [
        { freq: 587.33, duration: 0.085, gap: 0.09 },  // D5
        { freq: 698.46, duration: 0.085, gap: 0.09 },  // F5
        { freq: 783.99, duration: 0.085, gap: 0.09 },  // G5
        { freq: 880.00, duration: 0.13,  gap: 0.14 },  // A5
        { freq: 783.99, duration: 0.075, gap: 0.08 },  // G5
        { freq: 880.00, duration: 0.075, gap: 0.08 },  // A5
        { freq: 1174.66, duration: 0.34, gap: 0.35 }   // D6 (Grand Treasure Finale!)
      ];

      let noteTime = now;
      fanfareNotes.forEach((note, idx) => {
        // Warm brass lead + octave harmonic
        const oscLead = ctx.createOscillator();
        const oscHarm = ctx.createOscillator();
        const filter = ctx.createBiquadFilter();
        const gain = ctx.createGain();

        oscLead.type = 'sawtooth';
        oscHarm.type = 'triangle';
        oscLead.frequency.setValueAtTime(note.freq, noteTime);
        oscHarm.frequency.setValueAtTime(note.freq * 0.5, noteTime);

        filter.type = 'lowpass';
        filter.frequency.setValueAtTime(2400, noteTime);

        const peakGain = idx === fanfareNotes.length - 1 ? 0.13 : 0.095;
        gain.gain.setValueAtTime(0.01, noteTime);
        gain.gain.linearRampToValueAtTime(peakGain, noteTime + 0.015);
        gain.gain.exponentialRampToValueAtTime(0.001, noteTime + note.duration);

        oscLead.connect(filter);
        oscHarm.connect(filter);
        filter.connect(gain);
        gain.connect(ctx.destination);

        oscLead.start(noteTime);
        oscHarm.start(noteTime);
        oscLead.stop(noteTime + note.duration);
        oscHarm.stop(noteTime + note.duration);

        noteTime += note.gap;
      });

      // Sparkling Gold Treasure Shimmer at the end of the fanfare
      const shimmerStart = now + 0.52;
      [2349.32, 2959.96, 3520.0, 4698.63].forEach((freq, i) => {
        const osc = ctx.createOscillator();
        const gain = ctx.createGain();
        const t = shimmerStart + i * 0.045;
        osc.type = 'sine';
        osc.frequency.setValueAtTime(freq, t);
        gain.gain.setValueAtTime(0.06, t);
        gain.gain.exponentialRampToValueAtTime(0.001, t + 0.22);
        osc.connect(gain);
        gain.connect(ctx.destination);
        osc.start(t);
        osc.stop(t + 0.22);
      });
    } catch (e) {}
  }

  // 3. One Piece "DON!!" (どん!!) Taiko Drum + Wanted Poster Paper Slap for returning to POR CAZAR
  function playGameOverSound() {
    try {
      const ctx = getAudioContext();
      const now = ctx.currentTime;

      // A) Crisp Parchment Poster Slap (Noise burst filtered around 1.1kHz)
      const bufferSize = Math.floor(ctx.sampleRate * 0.055);
      const noiseBuffer = ctx.createBuffer(1, bufferSize, ctx.sampleRate);
      const data = noiseBuffer.getChannelData(0);
      for (let i = 0; i < bufferSize; i++) {
        data[i] = (Math.random() * 2 - 1) * Math.exp(-i / (bufferSize * 0.35));
      }
      const noise = ctx.createBufferSource();
      noise.buffer = noiseBuffer;
      const bandpass = ctx.createBiquadFilter();
      bandpass.type = 'bandpass';
      bandpass.frequency.setValueAtTime(1100, now);
      bandpass.Q.setValueAtTime(1.8, now);
      const noiseGain = ctx.createGain();
      noiseGain.gain.setValueAtTime(0.18, now);
      noiseGain.gain.exponentialRampToValueAtTime(0.001, now + 0.055);
      noise.connect(bandpass);
      bandpass.connect(noiseGain);
      noiseGain.connect(ctx.destination);
      noise.start(now);

      // B) Iconic Deep "DON!!" Taiko Drum / Pirate Cannon Impact
      const drumOsc = ctx.createOscillator();
      const subOsc = ctx.createOscillator();
      const drumGain = ctx.createGain();

      drumOsc.type = 'triangle';
      subOsc.type = 'sine';

      drumOsc.frequency.setValueAtTime(145, now);
      drumOsc.frequency.exponentialRampToValueAtTime(46, now + 0.28);

      subOsc.frequency.setValueAtTime(92, now);
      subOsc.frequency.exponentialRampToValueAtTime(36, now + 0.32);

      drumGain.gain.setValueAtTime(0.22, now);
      drumGain.gain.exponentialRampToValueAtTime(0.001, now + 0.34);

      drumOsc.connect(drumGain);
      subOsc.connect(drumGain);
      drumGain.connect(ctx.destination);

      drumOsc.start(now);
      subOsc.start(now);
      drumOsc.stop(now + 0.34);
      subOsc.stop(now + 0.34);
    } catch (e) {}
  }

  // Helper to spawn lightweight golden sparks burst on MAXIADO state
  function triggerGoldenSparks(card: HTMLElement) {
    const particleCount = 8;
    const frag = document.createDocumentFragment();
    const sparks: HTMLSpanElement[] = [];

    for (let i = 0; i < particleCount; i++) {
      const spark = document.createElement('span');
      spark.className = 'spark-particle';

      const size = Math.random() * 6 + 4;
      spark.style.width = `${size}px`;
      spark.style.height = `${size}px`;
      spark.style.left = `calc(50% - ${size / 2}px)`;
      spark.style.top = `calc(50% - ${size / 2}px)`;

      const angle = (Math.PI * 2 * i) / particleCount + (Math.random() - 0.5) * 0.4;
      const distance = Math.random() * 80 + 35;
      const tx = Math.cos(angle) * distance;
      const ty = Math.sin(angle) * distance;
      const rot = (Math.random() - 0.5) * 180;

      spark.style.setProperty('--tx', `${tx}px`);
      spark.style.setProperty('--ty', `${ty}px`);
      spark.style.setProperty('--rot', `${rot}deg`);

      frag.appendChild(spark);
      sparks.push(spark);
    }

    card.appendChild(frag);
    setTimeout(() => {
      sparks.forEach((s) => s.remove());
    }, 520);
  }

  // Event Delegation on Grid: updates ONLY the clicked card instead of all 162 cards
  const spriteGridEl = document.getElementById('sprite-grid');
  if (spriteGridEl) {
    spriteGridEl.addEventListener('click', (e) => {
      const target = e.target as HTMLElement | null;
      const card = target?.closest<HTMLElement>('.sprite-card');
      if (!card) return;

      const ref = cardRefMap.get(card);
      if (!ref) return;

      card.classList.add('is-glitching');
      setTimeout(() => {
        card.classList.remove('is-glitching');
      }, 340);

      const currentState = spriteStates.get(ref.id) || 'unmarked';

      if (currentState === 'unmarked') {
        spriteStates.set(ref.id, 'marked');
        playObtainedSound();
      } else if (currentState === 'marked') {
        spriteStates.set(ref.id, 'maxed');
        triggerGoldenSparks(card);
        playMaxed1UpSound();
      } else {
        spriteStates.delete(ref.id);
        playGameOverSound();
      }

      const t = i18nDict[currentLang] || i18nDict['es'];
      syncSingleCardDOM(ref, t, currentSearch.trim().toLowerCase());
      updateStatsCounters();
    });
  }

  // Season Filter Buttons
  function setSeason(season: 'c7s5' | 'c7s4' | 'all') {
    currentSeason = season;
    seasonBtns.forEach((btn) => {
      btn.classList.toggle('active', btn.dataset.season === season);
    });
    updateUI();
  }

  seasonBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      const season = (btn.dataset.season || 'all') as 'c7s5' | 'c7s4' | 'all';
      setSeason(season);
    });
  });

  if (btnSwitchToC7s4) {
    btnSwitchToC7s4.addEventListener('click', () => {
      setSeason('c7s4');
    });
  }

  // Filter Buttons
  filterBtns.forEach((btn) => {
    btn.addEventListener('click', () => {
      filterBtns.forEach((b) => b.classList.remove('active'));
      btn.classList.add('active');
      currentFilter = btn.dataset.filter || 'all';
      updateUI();
    });
  });

  // Search Input Handler (Debounced to avoid layout thrashing on fast typing)
  let searchDebounceTimer: ReturnType<typeof setTimeout> | null = null;
  if (searchInput) {
    searchInput.addEventListener('input', (e) => {
      currentSearch = (e.target as HTMLInputElement).value;
      if (searchDebounceTimer !== null) clearTimeout(searchDebounceTimer);
      searchDebounceTimer = setTimeout(() => {
        updateUI();
      }, 90);
    });
  }

  // Quick Selection Helpers
  if (btnSelectAll) {
    btnSelectAll.addEventListener('click', () => {
      cards.forEach((card) => {
        const season = card.dataset.season || 'c7s4';
        if (currentSeason === 'all' || season === currentSeason) {
          const id = card.dataset.id;
          if (id) spriteStates.set(id, 'marked');
        }
      });
      updateUI();
    });
  }

  if (btnSelectMaxed) {
    btnSelectMaxed.addEventListener('click', () => {
      cards.forEach((card) => {
        const season = card.dataset.season || 'c7s4';
        if (currentSeason === 'all' || season === currentSeason) {
          const id = card.dataset.id;
          if (id) spriteStates.set(id, 'maxed');
        }
      });
      updateUI();
    });
  }

  if (btnDeselectAll) {
    btnDeselectAll.addEventListener('click', () => {
      cards.forEach((card) => {
        const season = card.dataset.season || 'c7s4';
        if (currentSeason === 'all' || season === currentSeason) {
          const id = card.dataset.id;
          if (id) spriteStates.delete(id);
        }
      });
      updateUI();
    });
  }

  // Helper to ensure all images in a container are loaded and decoded before canvas capture
  async function ensureAllImagesLoaded(container: HTMLElement): Promise<void> {
    const imgs = Array.from(container.querySelectorAll<HTMLImageElement>('.sprite-img'));
    const loadPromises = imgs.map((img) => {
      img.loading = 'eager';

      if (img.complete && img.naturalWidth > 0) {
        return Promise.resolve();
      }

      return new Promise<void>((resolve) => {
        let isDone = false;
        const done = () => {
          if (!isDone) {
            isDone = true;
            img.removeEventListener('load', done);
            img.removeEventListener('error', done);
            resolve();
          }
        };

        img.addEventListener('load', done);
        img.addEventListener('error', done);

        // Safety fallback timer (max 3 seconds per image)
        setTimeout(done, 3000);

        if (img.decode) {
          img.decode().then(done).catch(() => {});
        }
      });
    });

    await Promise.all(loadPromises);
  }

  // Download PNG Template
  if (btnDownloadPng) {
    btnDownloadPng.addEventListener('click', async () => {
      const captureArea = document.getElementById('template-capture-area');
      if (!captureArea) return;

      const t = i18nDict[currentLang] || i18nDict['es'];

      const visibleCards = Array.from(captureArea.querySelectorAll<HTMLElement>('.sprite-card')).filter(
        (c) => c.style.display !== 'none'
      );
      const cardCount = visibleCards.length;
      if (cardCount === 0) {
        alert(currentLang === 'es' ? 'No hay espíritus visibles en esta vista para descargar.' : 'No visible sprites in this view to download.');
        return;
      }

      if (modalExport && modalTitle && modalDesc) {
        modalTitle.textContent = t.modalTitle;
        modalDesc.innerHTML = t.modalDesc;
        modalExport.classList.add('active');
      }

      try {
        // Preload and decode all images so offscreen images are fully fetched and rendered before capture
        await ensureAllImagesLoaded(captureArea);
        await new Promise((resolve) => setTimeout(resolve, 200));

        const activeTheme = document.documentElement.dataset.styleTheme || 'treasure';
        const exportBgMap: Record<string, string> = {
          treasure: '#091426',
          popart: '#24123b',
          parchment: '#1b2c47',
          manga: '#060609',
          punk: '#1d0b29',
          bubble: '#1f0c24'
        };

        // Determine column count and exact target width based on number of visible cards
        const columns = Math.min(Math.max(cardCount, 1), 5);
        let targetWidth = 1240;
        if (columns === 1) targetWidth = 460;
        else if (columns === 2) targetWidth = 660;
        else if (columns === 3) targetWidth = 920;
        else if (columns === 4) targetWidth = 1120;
        else targetWidth = 1240;

        const canvas = await html2canvas(captureArea, {
          backgroundColor: exportBgMap[activeTheme] || '#091426',
          scale: 2,
          logging: false,
          useCORS: true,
          allowTaint: true,
          width: targetWidth,
          windowWidth: targetWidth,
          scrollX: 0,
          scrollY: 0,
          onclone: (clonedDoc) => {
            // Ensure cloned document and body match the target width to prevent mobile viewport clipping
            clonedDoc.documentElement.style.width = `${targetWidth}px`;
            clonedDoc.documentElement.style.minWidth = `${targetWidth}px`;
            clonedDoc.body.style.width = `${targetWidth}px`;
            clonedDoc.body.style.minWidth = `${targetWidth}px`;
            clonedDoc.body.style.margin = '0';
            clonedDoc.body.style.padding = '0';
            clonedDoc.body.style.overflow = 'visible';

            const clonedMain = clonedDoc.querySelector('main');
            if (clonedMain) {
              clonedMain.style.width = `${targetWidth}px`;
              clonedMain.style.maxWidth = `${targetWidth}px`;
              clonedMain.style.margin = '0 auto';
              clonedMain.style.padding = '0';
            }

            const clonedArea = clonedDoc.getElementById('template-capture-area');
            if (clonedArea) {
              clonedArea.style.width = `${targetWidth}px`;
              clonedArea.style.maxWidth = `${targetWidth}px`;
              clonedArea.style.margin = '0 auto';
              clonedArea.style.padding = '1.75rem';
              clonedArea.style.boxSizing = 'border-box';

              // Top rainbow line spans 100% seamlessly
              const clonedTopBar = clonedArea.querySelector<HTMLElement>('.template-top-rainbow-bar');
              if (clonedTopBar) {
                clonedTopBar.style.width = '100%';
                clonedTopBar.style.left = '0';
                clonedTopBar.style.right = '0';
              }

              // Balanced watermark header layout
              const clonedHeader = clonedArea.querySelector<HTMLElement>('.template-watermark-header');
              if (clonedHeader) {
                clonedHeader.style.display = 'flex';
                clonedHeader.style.flexDirection = targetWidth < 800 ? 'column' : 'row';
                clonedHeader.style.justifyContent = 'space-between';
                clonedHeader.style.alignItems = targetWidth < 800 ? 'flex-start' : 'flex-end';
                clonedHeader.style.gap = '1.25rem';
                clonedHeader.style.width = '100%';
                clonedHeader.style.marginBottom = '1.85rem';
              }

              const clonedLegend = clonedArea.querySelector<HTMLElement>('.template-legend-row');
              if (clonedLegend) {
                clonedLegend.style.display = 'flex';
                clonedLegend.style.flexDirection = 'row';
                clonedLegend.style.flexWrap = targetWidth < 700 ? 'wrap' : 'nowrap';
                clonedLegend.style.gap = '1rem';
                clonedLegend.style.alignItems = 'center';
              }

              // Symmetrical grid columns with no blank ghost tracks
              const clonedGrid = clonedArea.querySelector<HTMLElement>('.sprite-grid');
              if (clonedGrid) {
                clonedGrid.style.display = 'grid';
                clonedGrid.style.gridTemplateColumns = `repeat(${columns}, 1fr)`;
                clonedGrid.style.gap = '1.5rem';
                clonedGrid.style.width = '100%';
              }

              clonedArea.querySelectorAll('.card-hover-tip').forEach((el) => {
                (el as HTMLElement).style.display = 'none';
              });

              clonedArea.querySelectorAll<HTMLElement>('.sprite-card').forEach((c) => {
                c.style.contentVisibility = 'visible';
                c.style.contain = 'none';
              });
            }

            const clonedImgs = clonedDoc.querySelectorAll<HTMLImageElement>('.sprite-img');
            clonedImgs.forEach((img) => {
              img.loading = 'eager';
              img.decoding = 'sync';
              img.style.opacity = '1';
              img.style.animation = 'none';
              img.style.transition = 'none';
              img.style.transform = 'none';
              img.style.filter = 'none';
              img.style.objectFit = 'contain';
              img.style.width = 'auto';
              img.style.height = 'auto';
              img.style.maxWidth = '100%';
              img.style.maxHeight = '100%';
            });
          }
        });

        const mainTitleWord = currentLang === 'es' ? 'cazatesoros' : 'treasure-hunters';
        const seasonSuffix = currentSeason === 'all' ? 'todas' : currentSeason;
        const filterSuffix = currentFilter === 'marked' ? 'obtenidos' : currentFilter === 'maxed' ? 'maxiados' : currentFilter === 'unmarked' ? 'faltantes' : 'todos';

        canvas.toBlob((blob) => {
          if (blob) {
            saveAs(blob, `fortnite-${mainTitleWord}-${seasonSuffix}-${filterSuffix}-${Date.now()}.png`);
          }
        }, 'image/png');
      } catch (err) {
        console.error('Error generating PNG export', err);
        alert('Ocurrió un error al generar la imagen PNG.');
      } finally {
        if (modalExport) modalExport.classList.remove('active');
      }
    });
  }

  // Language Switcher Events
  document.getElementById('lang-btn-es')?.addEventListener('click', () => applyLanguage('es'));
  document.getElementById('lang-btn-en')?.addEventListener('click', () => applyLanguage('en'));

  // Random Multiverse Style on Entry + Style Shift on Every Click
  const validThemes = ['treasure', 'popart', 'parchment', 'manga', 'punk', 'bubble'];
  let currentTheme = validThemes[Math.floor(Math.random() * validThemes.length)];

  function applyStyleTheme(theme: string) {
    currentTheme = theme;
    document.documentElement.dataset.styleTheme = theme;
  }

  function pickRandomDifferentTheme(): string {
    const others = validThemes.filter((t) => t !== currentTheme);
    return others[Math.floor(Math.random() * others.length)];
  }

  // Apply random theme when user enters the page
  applyStyleTheme(currentTheme);

  // Allow switching theme only when clicking the Hero Banner or Season Pill (avoids full-DOM CSS variable recalculation on every card click)
  document.querySelector('.hero-banner')?.addEventListener('click', () => {
    applyStyleTheme(pickRandomDifferentTheme());
  });
  document.getElementById('nav-season-text')?.addEventListener('click', () => {
    applyStyleTheme(pickRandomDifferentTheme());
  });

  // Animated TREASURE HUNTERS Title: Cycles Font & Style Every 5 Seconds when visible
  const heroMainTitleEl = document.querySelector<HTMLElement>('.treasure-main-title');
  const titleFontStyles = [
    'title-font-burbank',
    'title-font-gold',
    'title-font-halftone',
    'title-font-punk',
    'title-font-bubble',
    'title-font-blocks',
    'title-font-popart',
    'title-font-verypunk',
    'title-font-graffiti',
    'title-font-cubic'
  ];
  let currentTitleStyleIdx = 0;
  let titleCycleInterval: ReturnType<typeof setInterval> | null = null;
  let isHeroTitleVisible = true;

  function cycleHeroTitleStyle() {
    if (!heroMainTitleEl || !isHeroTitleVisible || document.hidden) return;
    heroMainTitleEl.classList.remove(...titleFontStyles, 'is-title-morphing');

    currentTitleStyleIdx = (currentTitleStyleIdx + 1) % titleFontStyles.length;
    const nextClass = titleFontStyles[currentTitleStyleIdx];

    const isEs = currentLang === 'es';
    if (nextClass === 'title-font-cubic') {
      heroMainTitleEl.textContent = isEs ? 'cazatesoros' : 'treasure hunters';
    } else if (nextClass === 'title-font-verypunk') {
      heroMainTitleEl.textContent = isEs ? 'CAZATeSOROS' : 'TREASuRE HunTERS';
    } else {
      heroMainTitleEl.textContent = isEs ? 'CAZATESOROS' : 'TREASURE HUNTERS';
    }
    heroMainTitleEl.setAttribute('data-text', heroMainTitleEl.textContent || '');

    heroMainTitleEl.classList.add(nextClass, 'is-title-morphing');

    setTimeout(() => {
      heroMainTitleEl.classList.remove('is-title-morphing');
    }, 340);
  }

  function startTitleCycle() {
    if (titleCycleInterval !== null) return;
    titleCycleInterval = setInterval(cycleHeroTitleStyle, 5000);
  }

  function stopTitleCycle() {
    if (titleCycleInterval !== null) {
      clearInterval(titleCycleInterval);
      titleCycleInterval = null;
    }
    heroMainTitleEl?.classList.remove('is-title-morphing');
  }

  if (heroMainTitleEl) {
    heroMainTitleEl.classList.add(titleFontStyles[0]);

    if ('IntersectionObserver' in window) {
      const titleObserver = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            isHeroTitleVisible = entry.isIntersecting;
            if (entry.isIntersecting && !document.hidden) {
              startTitleCycle();
            } else {
              stopTitleCycle();
            }
          });
        },
        { threshold: 0.1 }
      );
      titleObserver.observe(heroMainTitleEl);
    } else {
      startTitleCycle();
    }

    document.addEventListener('visibilitychange', () => {
      if (document.hidden) {
        stopTitleCycle();
      } else if (isHeroTitleVisible) {
        startTitleCycle();
      }
    });
  }

  // Initial Language Setup
  applyLanguage(currentLang);

  // Service Worker Registration for PWA support
  if ('serviceWorker' in navigator) {
    window.addEventListener('load', () => {
      navigator.serviceWorker.register('/sw.js').catch((err) => {
        console.log('ServiceWorker registration error:', err);
      });
    });
  }

  // PWA Install Prompt Handler
  let deferredPrompt: any = null;
  const pwaInstallBtn = document.getElementById('pwa-install-btn');

  window.addEventListener('beforeinstallprompt', (e) => {
    e.preventDefault();
    deferredPrompt = e;
    if (pwaInstallBtn) {
      pwaInstallBtn.style.display = 'inline-flex';
    }
  });

  if (pwaInstallBtn) {
    pwaInstallBtn.addEventListener('click', async () => {
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          pwaInstallBtn.style.display = 'none';
        }
        deferredPrompt = null;
      }
    });
  }

  window.addEventListener('appinstalled', () => {
    if (pwaInstallBtn) pwaInstallBtn.style.display = 'none';
    const toastBanner = document.getElementById('install-toast-banner');
    if (toastBanner) toastBanner.classList.remove('active');
    deferredPrompt = null;
  });

  // Non-Intrusive PWA Toast Notification Trigger
  const TOAST_DISMISSED_KEY = 'fortnite_sprites_install_toast_closed';
  const toastBanner = document.getElementById('install-toast-banner');
  const toastCloseBtn = document.getElementById('toast-close-btn');
  const toastInstallBtn = document.getElementById('toast-install-action');
  const toastDismissBtn = document.getElementById('toast-dismiss-action');

  function dismissToast() {
    if (toastBanner) toastBanner.classList.remove('active');
    try {
      localStorage.setItem(TOAST_DISMISSED_KEY, 'true');
    } catch (e) {}
  }

  if (toastCloseBtn) toastCloseBtn.addEventListener('click', dismissToast);
  if (toastDismissBtn) toastDismissBtn.addEventListener('click', dismissToast);

  if (toastInstallBtn) {
    toastInstallBtn.addEventListener('click', async () => {
      dismissToast();
      if (deferredPrompt) {
        deferredPrompt.prompt();
        const choice = await deferredPrompt.userChoice;
        if (choice && choice.outcome === 'accepted') {
          if (pwaInstallBtn) pwaInstallBtn.style.display = 'none';
        }
        deferredPrompt = null;
      } else {
        // Fallback info for iOS / browsers without beforeinstallprompt
        alert(currentLang === 'es' 
          ? 'Para instalar en tu móvil:\n• En Safari (iPhone): Toca Compartir (⎋) ➔ "Agregar a inicio"\n• En Android: Toca Opciones (⋮) ➔ "Instalar aplicación"'
          : 'To install on your device:\n• On Safari (iPhone): Tap Share (⎋) ➔ "Add to Home Screen"\n• On Android: Tap Menu (⋮) ➔ "Install app"'
        );
      }
    });
  }

  // Trigger toast after 18 seconds of interaction if not previously dismissed
  const isDismissed = localStorage.getItem(TOAST_DISMISSED_KEY) === 'true';
  if (!isDismissed) {
    setTimeout(() => {
      if (toastBanner && !localStorage.getItem(TOAST_DISMISSED_KEY)) {
        toastBanner.classList.add('active');
      }
    }, 18000);
  }
</script>

      templateTitle: 'PLANTILLA DE ESPÍRITUS',
      epicPartnerText: 'Apóyame usando el código <strong style="color: var(--neon-magenta);">MUDO</strong> en la tienda de Fortnite <span class="epic-tag">#EpicPartner</span>',
      cardHoverTip: '💡 Clic: FALTANTE ➔ OBTENIDO ➔ MAXIADO',
      missingBadge: '¡ESPÍRITU FALTANTE!',
      obtainedBadge: 'OBTENIDO',
      maxedBadge: 'MAXIADO',
      legendMissing: 'FALTANTE (DESTACADO)',
      legendObtained: 'OBTENIDO (MARCADO)',
      legendMaxed: 'MAXIADO (MÁXIMO)',

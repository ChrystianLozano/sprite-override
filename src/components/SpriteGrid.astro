    <!-- Sprites Grid -->
    <div id="sprite-grid" class="sprite-grid">
      {sprites.map((sprite) => (
        <article 
          class="sprite-card unmarked" 
          data-id={sprite.id}
          data-title-es={sprite.titleEs}
          data-title-en={sprite.titleEn}
          data-title={sprite.titleEs.toLowerCase()}
          data-filename={sprite.filename}
          data-imgsrc={sprite.imageSrc}
        >
          <div class="card-header-overlay">
            <span class="sprite-badge">
              <span class="status-icon">🔥</span>
              <span class="status-text">¡ESPÍRITU FALTANTE!</span>
            </span>
            <div class="checkbox-custom">
              <svg class="check-icon" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3.5" stroke-linecap="round" stroke-linejoin="round" style="display: none;">
                <polyline points="20 6 9 17 4 12"></polyline>
              </svg>
              <span class="star-icon" style="display: none; font-size: 13px; font-weight: 900;">👑</span>
            </div>
          </div>

          <div class="sprite-image-wrapper">
            <img 
              src={sprite.imageSrc} 
              alt={sprite.titleEs} 
              width={sprite.imageMetadata.width}
              height={sprite.imageMetadata.height}

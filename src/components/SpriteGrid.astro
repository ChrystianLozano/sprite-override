        </div>
      </div>

      <div class="cyber-stats-count">
        <div><span id="i18n-obtained-label">OBTENIDOS:</span> <strong id="marked-count" style="color: var(--neon-green);">0</strong></div>
        <div><span id="i18n-maxed-label">MAXIADOS:</span> <strong id="maxed-count" style="color: var(--neon-yellow);">0</strong></div>
        <div><span id="i18n-missing-label">FALTANTES:</span> <strong id="unmarked-count" style="color: var(--neon-magenta);">0</strong></div>
      </div>

      <div style="display: flex; gap: 0.75rem; flex-wrap: wrap;">
        <button id="btn-download-png" class="btn-cyber" title="Descargar plantilla según la pestaña activa">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"></path>
            <polyline points="7 10 12 15 17 10"></polyline>
            <line x1="12" y1="15" x2="12" y2="3"></line>
          </svg>
          <span id="i18n-download-btn">DESCARGAR PLANTILLA</span>
        </button>
      </div>
    </div>

    <!-- Filter Toolbar Section -->
    <div class="cyber-toolbar">
      <!-- Filter Tabs -->
      <div class="cyber-filters">
        <button class="cyber-tab active" data-filter="all"><span id="i18n-tab-all">TODOS</span> ({sprites.length})</button>
        <button class="cyber-tab" data-filter="marked"><span id="i18n-tab-marked">✓ OBTENIDOS</span> (<span id="filter-marked-count">0</span>)</button>
        <button class="cyber-tab maxed-tab" data-filter="maxed"><span id="i18n-tab-maxed">👑 MAXIADOS</span> (<span id="filter-maxed-count">0</span>)</button>
        <button class="cyber-tab unmarked-tab" data-filter="unmarked"><span id="i18n-tab-unmarked">🔥 FALTANTES</span> (<span id="filter-unmarked-count">{sprites.length}</span>)</button>
      </div>

      <!-- Quick Selection Helpers -->
      <div class="quick-buttons-box" style="display: flex; gap: 0.5rem; flex-wrap: wrap;">
        <button id="btn-select-all" class="btn-cyber-dark" style="font-size: 0.75rem; padding: 0.4rem 0.8rem;">MARCAR OBTENIDOS</button>
        <button id="btn-select-maxed" class="btn-cyber-dark" style="font-size: 0.75rem; padding: 0.4rem 0.8rem; color: var(--neon-yellow); border-color: rgba(221, 255, 0, 0.4);">MARCAR MAXIADOS</button>
        <button id="btn-deselect-all" class="btn-cyber-dark" style="font-size: 0.75rem; padding: 0.4rem 0.8rem;">DESMARCAR TODOS</button>
      </div>

      <!-- Search Input -->
      <div class="cyber-search-box">
        <input type="text" id="search-input" class="cyber-search-input" placeholder="BUSCAR ESPÍRITU..." />
      </div>
    </div>
  </div>
</div>

<!-- Main Template Container (Capturable for PNG Export) -->
<main style="max-width: 1200px; margin: 0 auto; padding: 0 0.5rem 4rem;">
  <div id="template-capture-area" class="template-card-container">
    <div class="template-watermark-header">

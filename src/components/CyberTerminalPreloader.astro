---
---
<!-- TREASURE HUNTERS MULTIVERSE STYLE-SHIFT PRELOADER -->
<div id="cyber-preloader" class="cyber-preloader-overlay">
  <div class="preloader-halftone-bg"></div>
  <div class="terminal-box">
    <div class="terminal-header">
      <div class="terminal-title">
        <span class="compass-spin">🧭</span> CAZATESOROS.EXE // トレジャーハンターズ
      </div>
      <div class="retro-window-controls">
        <span class="win-btn">□</span>
        <span class="win-btn">_</span>
        <span class="win-btn win-close">X</span>
      </div>
    </div>

    <div class="terminal-body">
      <!-- Dynamic Font-Shifting Teaser Logo (Inspired by estio1-estio6) -->
      <div class="preloader-logo-stage">
        <span class="preloader-katakana">フォートナイト • トレジャーハンターズ</span>
        <div id="preloader-style-word" class="preloader-style-word style-step-1">FORTNITE</div>
        <div class="preloader-sub-pill">THE GREATEST ADVENTURE OF ALL TIME</div>
      </div>

      <div id="terminal-lines" class="terminal-lines">
        <!-- Dynamic adventure logs inserted via JS -->
      </div>

      <div class="terminal-progress-container">
        <div class="terminal-progress-text">
          <span id="term-status-label">ABRIendo COFRE DEL TESORO...</span>
          <span id="term-percent">0%</span>
        </div>
        <div class="terminal-progress-bar-bg">
          <div id="term-progress-bar-fill" class="terminal-progress-bar-fill"></div>
        </div>
      </div>
    </div>
  </div>
</div>

<script>
  const terminalMessages = [
    { text: "DESPLEGANDO MAPA DEL TESORO [CAPÍTULO 7 • MINI TEMPORADA]...", status: "MAPA OK", styleClass: "style-step-1", delay: 120 },
    { text: "CARGANDO ARTE POP-ART, PUNK ZINE & MANGA HALFTONE...", status: "6 ESTILOS", styleClass: "style-step-2", delay: 320 },
    { text: "LOCALIZANDO ESPÍRITUS Y COFRES LEGENDARIOS...", status: "LISTO", styleClass: "style-step-3", delay: 540 },
    { text: "SINCRONIZANDO PLANTILLA [FORTNITE.MUDO.GAMES]...", status: "100%", styleClass: "style-step-4", delay: 760 },
    { text: "¡BIENVENIDO A CAZATESOROS!", status: "ZARPAR 🏴‍☠️", styleClass: "style-step-5", delay: 980 }
  ];

  const linesContainer = document.getElementById('terminal-lines');
  const progressBarFill = document.getElementById('term-progress-bar-fill');
  const percentText = document.getElementById('term-percent');
  const preloader = document.getElementById('cyber-preloader');
  const styleWord = document.getElementById('preloader-style-word');

  function runTreasureSequence() {
    terminalMessages.forEach((msg, idx) => {
      setTimeout(() => {
        if (!linesContainer) return;

        if (styleWord && msg.styleClass) {
          styleWord.className = `preloader-style-word ${msg.styleClass}`;
        }

        const lineEl = document.createElement('div');
        lineEl.className = 'term-line';
        lineEl.innerHTML = `
          <span class="term-prefix">✦</span>
          <span class="term-text">${msg.text}</span>
          ${msg.status ? `<span class="term-status-ok">[${msg.status}]</span>` : ''}
        `;
        linesContainer.appendChild(lineEl);

        const progressPercent = Math.min(100, Math.round(((idx + 1) / terminalMessages.length) * 100));
        if (progressBarFill) progressBarFill.style.width = `${progressPercent}%`;
        if (percentText) percentText.textContent = `${progressPercent}%`;

        if (idx === terminalMessages.length - 1) {
          setTimeout(() => {
            if (preloader) {
              preloader.classList.add('preloader-hidden');
              setTimeout(() => {
                preloader.remove();
              }, 450);
            }
          }, 250);
        }
      }, msg.delay);
    });

    setTimeout(() => {
      if (preloader && preloader.isConnected) {
        preloader.classList.add('preloader-hidden');
        setTimeout(() => {
          preloader.remove();
        }, 450);
      }
    }, 1800);
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', runTreasureSequence);
  } else {
    runTreasureSequence();
  }
</script>

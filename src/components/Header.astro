---
---
<!-- Fortnite Game Navigation Bar -->
<nav class="fortnite-nav">
  <div class="nav-container">
    <div class="nav-brand">
      <a href="https://fortnite.mudo.games/" target="_blank" rel="noopener noreferrer" class="mudo-brand-logo" data-text="fortnite.mudo.games">fortnite.mudo.games</a>
    </div>
    
    <div class="nav-status" style="display: flex; align-items: center; gap: 1.25rem;">
      <div id="nav-season-text" style="font-family: var(--font-display); font-size: 0.85rem; color: var(--neon-cyan); letter-spacing: 1px;">
        CAPÍTULO 7 • TEMPORADA 4
      </div>
      <div class="lang-switcher">
        <button id="lang-btn-es" class="lang-btn active" data-lang="es">ES</button>
        <span class="lang-divider">|</span>
        <button id="lang-btn-en" class="lang-btn" data-lang="en">EN</button>
      </div>
    </div>
  </div>
</nav>

<!-- Hero Banner: FORTNITE GLITCH / OVERRIDE -->
<section class="hero-banner">
  <div class="fn-chapter-title">
    <span class="fortnite-logo-text">FORTNITE</span> • <span id="hero-subtitle-text">CAPÍTULO 7 | TEMPORADA 4</span>
  </div>

  <div class="glitch-wrapper">
    <!-- Chromatic Aberration Glitch Title (GLITCH in Spanish, OVERRIDE in English) -->
    <h1 class="glitch-title" data-text="GLITCH">GLITCH</h1>
    
    <!-- Color Glitch Block Cuts (Yellow, Magenta, Green) -->
    <span class="glitch-block-1"></span>
    <span class="glitch-block-2"></span>
  </div>

  <div>
    <div id="hero-slogan-pill" class="slogan-pill">
      ROMPE LAS REGLAS • CAMBIA EL JUEGO
    </div>
  </div>
</section>
